{
  "appId": "com.tabula.app",
  "productName": "Tabula",
  "directories": { "output": "dist-desktop" },
  "files": [
    "desktop/main.mjs",
    "desktop/preload.cjs",
    "dist/**/*",
    "!dist/**/*.d.ts",
    "!dist/**/*.map",
    "dist-app/**/*",
    "package.json"
  ],
  "extraMetadata": { "main": "desktop/main.mjs" },
  "asarUnpack": ["**/node_modules/sharp/**", "**/node_modules/@img/**"],
  "mac": { "target": ["dmg"], "category": "public.app-category.developer-tools" },
  "win": { "target": ["nsis"] },
  "linux": { "target": ["AppImage"] }
}
