{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": "..",
    "declaration": false,
    "declarationMap": false,
    "paths": {
      "tabula-pixi": [
        "../tabula-pixi/src/pixi-v7/index.ts"
      ],
      "tabula-pixi/json": [
        "../tabula-pixi/src/pixi-v7/json.ts"
      ],
      "tabula-pixi/core/*": [
        "../tabula-pixi/src/core/*"
      ]
    }
  },
  "include": [
    "src/**/*",
    "app/**/*.ts",
    "tests/**/*.ts",
    "scripts/**/*.ts",
    "vitest.config.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "dist-app"
  ]
}
